# Copie para ai/.env e ajuste os valores. Nunca commite o .env real.
# O Next.js fala com esta API pelo servidor; a chave não vai ao navegador.

# Segredo compartilhado entre o Next.js (VELO_IA_API_KEY) e esta API.
# Gere um valor longo, por exemplo: openssl rand -hex 32
VELO_IA_API_KEY=troque-por-um-segredo-longo

# Modelo base e adaptador LoRA. O adaptador pode ser uma pasta local
# (ai/velo-ia-lora) ou um repositório do Hugging Face (usuario/velo-ia-lora).
# ZeroGPU: Qwen/Qwen2.5-3B-Instruct.
# CPU Basic: Qwen/Qwen2.5-0.5B-Instruct (leve o suficiente para 2 vCPU/16 GB).
VELO_IA_MODEL=Qwen/Qwen2.5-3B-Instruct
VELO_IA_ADAPTER=velo-ia-lora

# Banco SQLite de curto prazo. Use um disco persistente em produção.
VELO_IA_MEMORY_DB=velo_ia_memory.db

# 1 = conversa sem carregar modelo (útil para testar a interface).
VELO_IA_MOCK=0

# 1 = tenta quantização 4-bit quando há GPU CUDA.
VELO_IA_4BIT=1

# Hugging Face Space: 1 = ZeroGPU (conta elegível, com mais de 30 dias);
# 0 = CPU Basic (Space Gradio exige plano PRO atualmente). O app.py não liga
# mais o ZeroGPU sozinho só porque o pacote `spaces` está instalado.
VELO_IA_ZERO_GPU=0
# Tempo máximo de cada chamada na GPU (segundos).
VELO_IA_GPU_DURATION=90

# Limite de tokens. Em CPU, 160 tokens novos já evitam respostas longas demais
# e mantêm o tempo dentro do timeout do proxy da Vercel.
VELO_IA_MAX_INPUT_TOKENS=4096
VELO_IA_MAX_NEW_TOKENS=320

# Endereço do servidor. Em produção, use 0.0.0.0 atrás de um proxy HTTPS.
VELO_IA_HOST=127.0.0.1
VELO_IA_PORT=8000
VELO_IA_LOG_LEVEL=INFO
